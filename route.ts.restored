import { NextResponse } from 'next/server';
import { llmProvider } from '@/lib/llm/llmProvider';

export async function POST(request: Request) {
  try {
    const { formData } = await request.json();
    const provider = new llmProvider();
    
    const prompt = `You are an expert AI voice agent architect. 
You are reviewing a configuration form filled out by a user to define their voice agent. 
Review the following form data:
${JSON.stringify(formData, null, 2)}

Identify any missing edge cases, ambiguities, or unspoken assumptions that could cause the agent to fail in production. 
Generate 2 to 3 concise, clarifying questions to ask the user to shore up these edge cases. 
If the data is absolutely perfectly complete, you can return 0 questions (but usually there's at least one edge case to handle).
Do not ask for information that is already explicitly provided in the form.

Return ONLY a JSON object matching this schema exactly:
{
  "questions": ["string"]
}

Example format:
{
  "questions": [
    "If a caller asks for a service you don't offer, what should the agent do?",
    "You mentioned 'after hours behavior', but what if the caller leaves a voicemail — how soon do you follow up?"
  ]
}`;

    const resString = await provider.generateRaw(prompt, 0.2, { 
      json: true, 
      contextLabel: "Review Form",
      systemInstruction: "You are an expert AI voice agent architect. Return strictly valid JSON."
    });
    
    const result = JSON.parse(resString);
    
    return NextResponse.json({ questions: result.questions || [] });
  } catch (error: any) {
    console.error("Error in review:", error);
    return NextResponse.json({ error: error.message }, { status: 500 });
  }
}