# =====================================================================
# VOICE AGENT PROMPT BUILDER - ENVIRONMENT CONFIGURATION
# =====================================================================

# 1. MONGODB DATABASE CONNECTION
DATABASE_URL="mongodb://localhost:27017/autoprompt"

# 2. QWEN (OPENAI-COMPATIBLE) LLM CONFIGURATION
# Required for the compiler node to run using Qwen/vLLM/Ollama.
QWEN_BASE_URL_FOR_LLM="http://localhost:8000/v1"
QWEN_API_KEY="EMPTY"
QWEN_MODEL="Qwen/Qwen3.6-35B-A3B-FP8"

# 4. NEXT.JS APP SETTINGS
NEXT_PUBLIC_APP_URL="http://localhost:3000"
