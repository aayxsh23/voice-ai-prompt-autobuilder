'use client';

import React, { useState, useEffect } from 'react';
import { useRouter } from 'next/navigation';
import BuilderForm from '@/components/project/BuilderForm';
import { ArrowRight, ShieldAlert } from 'lucide-react';

export default function ChatbotBuilderPage({ params }: { params: Promise<{ sessionId: string }> }) {
  const router = useRouter();
  const [sessionId, setSessionId] = useState<string>('');
  
  // Workflow States: 'form' | 'clarifying' | 'clarify' | 'generating' | 'studio'
  const [status, setStatus] = useState<'form' | 'clarifying' | 'clarify' | 'generating' | 'studio'>('form');
  
  const [formData, setFormData] = useState<any>(null);
  const [questions, setQuestions] = useState<string[]>([]);
  const [answers, setAnswers] = useState<string[]>([]);
  const [draft, setDraft] = useState<any>(null);
  const [activeTab, setActiveTab] = useState<'agent' | 'system' | 'combined'>('agent');
  const [creatingProject, setCreatingProject] = useState(false);

  useEffect(() => {
    params.then(p => {
      setSessionId(p.sessionId);
    });
  }, [params]);

  const handleFormSubmit = async (data: any) => {
    setFormData(data);
    setStatus('clarifying');
    
    try {
      const res = await fetch('/api/builder/review', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ formData: data })
      });
      const result = await res.json();
      if (result.questions && result.questions.length > 0) {
        setQuestions(result.questions);
        setAnswers(new Array(result.questions.length).fill(''));
        setStatus('clarify');
      } else {
        // No clarification needed, skip to generate
        handleGeneratePrompt(data, []);
      }
    } catch (err) {
      console.error(err);
      alert('Error connecting to the architect. Compiling directly.');
      handleGeneratePrompt(data, []);
    }
  };

  const handleGeneratePrompt = async (data: any, qaAnswers: string[]) => {
    setStatus('generating');
    
    // Convert flat formData to a partial BlueprintJson shape so compilePromptPackage understands it
    const businessSpec = {
      meta: {
        companyName: data.companyName || 'My Business',
        agentName: 'Voice Assistant',
        industry: data.goalPreset || 'General',
        primaryGoal: data.goalOther || data.goalPreset || 'Assist callers',
        languageMode: data.language === 'Multilingual' ? 'multilingual' : (data.language === 'Hindi' ? 'hindi' : 'english')
      },
      businessSnapshot: {
        operatingHours: 'Standard',
        servicesOffered: data.services?.map((s: any) => s.name) || [],
        policies: {
          cancellation: data.policies?.find((p: any) => p.type === 'Cancellation')?.desc || 'None',
          refunds: data.policies?.find((p: any) => p.type === 'Refund')?.desc || 'None',
          escalationNumbers: data.transferNumbers?.map((t: any) => t.number) || []
        }
      },
      knowledgeBase: {
        faqs: [], // We will just pass the faqBlob to the LLM as transcript or operational Context
        objections: []
      }
    };

    // Construct a transcript representing the user's form + clarifications
    let transcriptText = `User has configured a voice agent for ${data.companyName}.\n`;
    transcriptText += `Goal: ${businessSpec.meta.primaryGoal}\n`;
    transcriptText += `Address: ${data.address}\n`;
    transcriptText += `Phone: ${data.phone}\n`;
    transcriptText += `Website: ${data.website}\n`;
    transcriptText += `Staff: ${JSON.stringify(data.staffList)}\n`;
    transcriptText += `Services: ${JSON.stringify(data.services)}\n`;
    transcriptText += `Policies: ${JSON.stringify(data.policies)}\n`;
    transcriptText += `FAQs provided by user:\n${data.faqsBlob}\n`;
    transcriptText += `Call Flow Instructions: ${data.callFlowDescription}\n`;
    transcriptText += `Opening Line: ${data.openingLine}\n`;
    transcriptText += `Closing Script: ${data.closingScript}\n`;
    
    if (questions.length > 0) {
      transcriptText += `\nClarifications:\n`;
      questions.forEach((q, idx) => {
        transcriptText += `Q: ${q}\nA: ${qaAnswers[idx]}\n`;
      });
    }

    const payload = {
      sessionId,
      businessSpec,
      transcript: [{ role: 'user', content: transcriptText }]
    };

    try {
      const res = await fetch('/api/builder/generate-review', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const generatedDraft = await res.json();
      setDraft(generatedDraft);
      setStatus('studio');
    } catch (err) {
      console.error(err);
      alert('Failed to generate prompt package.');
      setStatus('form');
    }
  };

  const handleCreateProject = async () => {
    setCreatingProject(true);
    try {
      const res = await fetch('/api/builder/create-project', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          sessionId,
          draft,
          blueprint: { 
            useCase: formData.goalPreset,
            business: { companyName: formData.companyName, languageMode: formData.language }
          }
        })
      });
      const project = await res.json();
      if (project && project.id) {
        router.push(`/project/${project.id}`);
      } else {
        alert('Error saving project.');
        setCreatingProject(false);
      }
    } catch (err) {
      alert('Failed to save project workspace.');
      setCreatingProject(false);
    }
  };

  return (
    <div className="min-h-screen bg-[var(--color-cream-paper)] text-[var(--color-ink)] flex flex-col font-['DM_Sans'] selection:bg-[var(--color-sunshine-highlight)] selection:text-[var(--color-ink)]">
      
      {/* Header */}
      <header className="w-full flex items-center justify-between px-6 py-4 border-b border-[var(--color-ink)] bg-[var(--color-cream-paper)] sticky top-0 z-50">
        <div className="font-medium text-[16px] tracking-tight">TechLadder.ai</div>
        <div className="flex gap-2">
          <div className={\`w-2.5 h-2.5 rounded-full mt-1.5 \${status === 'form' ? 'bg-[var(--color-ink)]' : 'bg-[var(--color-graphite)]/30'}\`} />
          <div className={\`w-2.5 h-2.5 rounded-full mt-1.5 \${status === 'clarifying' || status === 'clarify' ? 'bg-[var(--color-ink)]' : 'bg-[var(--color-graphite)]/30'}\`} />
          <div className={\`w-2.5 h-2.5 rounded-full mt-1.5 \${status === 'generating' || status === 'studio' ? 'bg-[var(--color-ink)]' : 'bg-[var(--color-graphite)]/30'}\`} />
        </div>
      </header>

      <main className="flex-1 w-full max-w-[1000px] mx-auto p-4 sm:p-8">
        
        {/* STEP 1: FORM */}
        {status === 'form' && (
          <BuilderForm onSubmit={handleFormSubmit} loading={false} initial={formData} />
        )}

        {status === 'clarifying' && (
          <div className="flex flex-col items-center justify-center py-32 text-center">
             <div className="w-8 h-8 rounded-full border-2 border-[var(--color-ink)] border-t-transparent animate-spin mb-6" />
             <h2 className="text-[32px] font-medium leading-[1.25]">Auditing your configuration...</h2>
             <p className="text-[18px] text-[var(--color-graphite)] mt-2">Checking for edge cases and missing details.</p>
          </div>
        )}

        {/* STEP 2: CLARIFY */}
        {status === 'clarify' && (
          <div className="flex flex-col gap-8 max-w-[700px] mx-auto py-12">
            <div className="mb-4">
              <h2 className="text-[40px] font-medium leading-[1.25] tracking-[-1.02px]">A few final clarifications</h2>
              <p className="text-[18px] text-[var(--color-graphite)] mt-4 leading-[1.5]">
                To ensure a production-ready prompt, the AI architect needs clarification on these edge cases:
              </p>
            </div>
            
            {questions.map((q, idx) => (
              <div key={idx} className="bg-[var(--color-cream-paper)] border border-[var(--color-ink)] rounded-[24px] p-6 flex flex-col gap-4">
                <p className="font-medium text-[16px] leading-[1.4]">{q}</p>
                <textarea
                  className="w-full bg-[var(--color-cream-paper)] border border-[var(--color-ink)] rounded-[6px] px-3 py-2 text-[16px] text-[var(--color-ink)] placeholder-[var(--color-graphite)] focus:outline-none focus:ring-1 focus:ring-[var(--color-ink)] resize-y"
                  rows={3}
                  placeholder="Your answer..."
                  value={answers[idx]}
                  onChange={(e) => {
                    const newAns = [...answers];
                    newAns[idx] = e.target.value;
                    setAnswers(newAns);
                  }}
                />
              </div>
            ))}

            <button
              onClick={() => handleGeneratePrompt(formData, answers)}
              className="mt-8 bg-[var(--color-sunshine-highlight)] text-[var(--color-ink)] font-medium text-[16px] px-8 py-4 rounded-[24px] hover:brightness-95 transition-all flex items-center justify-center min-w-[200px]"
            >
              Generate Prompt Package
            </button>
          </div>
        )}

        {/* STEP 3: GENERATING */}
        {status === 'generating' && (
          <div className="flex flex-col items-center justify-center py-32 text-center">
             <div className="w-8 h-8 rounded-full border-2 border-[var(--color-ink)] border-t-transparent animate-spin mb-6" />
             <h2 className="text-[32px] font-medium leading-[1.25]">Compiling Prompt Package...</h2>
             <p className="text-[18px] text-[var(--color-graphite)] mt-2">Writing knowledge base, defining state machine, and applying guardrails.</p>
          </div>
        )}

        {/* STEP 4: STUDIO */}
        {status === 'studio' && draft && (
          <div className="flex flex-col h-[80vh] border border-[var(--color-ink)] rounded-[24px] bg-[#ffffff] overflow-hidden">
            
            {/* Studio Header */}
            <div className="bg-[var(--color-cream-paper)] px-6 py-4 border-b border-[var(--color-ink)] flex items-center justify-between gap-4 flex-wrap">
              <div className="flex items-center gap-3">
                <span className="w-3 h-3 rounded-full bg-[var(--color-mint-signal)]" />
                <span className="text-[16px] font-semibold flex items-center gap-1.5">
                  Split Prompts Studio
                </span>
              </div>

              <button
                onClick={handleCreateProject}
                disabled={creatingProject}
                className="px-6 py-2 rounded-[9999px] bg-[var(--color-sunshine-highlight)] text-[var(--color-ink)] font-medium text-[14px] transition-colors flex items-center gap-2 cursor-pointer border border-[var(--color-ink)] shadow-[2px_2px_0px_var(--color-ink)] active:shadow-none active:translate-y-[2px] active:translate-x-[2px]"
              >
                {creatingProject ? 'Saving...' : 'Finalize Workspace'}
                <ArrowRight className="w-4 h-4" />
              </button>
            </div>

            {/* Tabs */}
            <div className="bg-[var(--color-cream-paper)] px-4 pt-4 border-b border-[var(--color-ink)] flex items-center gap-2">
              <button
                onClick={() => setActiveTab('agent')}
                className={\`px-6 py-2 rounded-t-[12px] text-[14px] font-medium transition-colors border border-b-0 cursor-pointer \${activeTab === 'agent' ? 'bg-[#ffffff] text-[var(--color-ink)] border-[var(--color-ink)]' : 'bg-transparent text-[var(--color-graphite)] border-transparent hover:text-[var(--color-ink)]'}\`}
              >
                Agent Prompt
              </button>
              <button
                onClick={() => setActiveTab('system')}
                className={\`px-6 py-2 rounded-t-[12px] text-[14px] font-medium transition-colors border border-b-0 cursor-pointer \${activeTab === 'system' ? 'bg-[#ffffff] text-[var(--color-ink)] border-[var(--color-ink)]' : 'bg-transparent text-[var(--color-graphite)] border-transparent hover:text-[var(--color-ink)]'}\`}
              >
                System Prompt
              </button>
              <button
                onClick={() => setActiveTab('combined')}
                className={\`px-6 py-2 rounded-t-[12px] text-[14px] font-medium transition-colors border border-b-0 cursor-pointer \${activeTab === 'combined' ? 'bg-[#ffffff] text-[var(--color-ink)] border-[var(--color-ink)]' : 'bg-transparent text-[var(--color-graphite)] border-transparent hover:text-[var(--color-ink)]'}\`}
              >
                Combined Prompt
              </button>
            </div>

            {/* Code Output */}
            <div className="flex-1 bg-[#ffffff] p-6 overflow-y-auto font-mono text-[13px] leading-[1.6] text-[#000000] whitespace-pre-wrap">
              {activeTab === 'agent' && draft.agentPrompt}
              {activeTab === 'system' && draft.systemPrompt}
              {activeTab === 'combined' && draft.finalPrompt}
              
              {/* Fallback if agent/system split isn't there */}
              {activeTab !== 'combined' && !draft.agentPrompt && !draft.systemPrompt && draft.finalPrompt}
            </div>

          </div>
        )}

      </main>
    </div>
  );
}